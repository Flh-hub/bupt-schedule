# 构建产物（每次打包重新生成，不进版本库）
android/build/
android/dist/
*.apk
# 但官网主按钮直链的那一个必须入库：全新 clone 后部署，下载按钮不能 404
!site/dl/*.apk
*.idsig

# 依赖
node_modules/

# 临时文件与截图
.tmp-*
.shots/
*.log
probe__*.html

# 系统与编辑器
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# 临时截图（多为手机全屏截图，含屏幕内容，绝不入库）
/.s*.png
/.probe.png
/.shot*.png
/.timecol*.png
/.check*.png

# 图标生成的中间产物（成品已进 android/res/drawable-*）
.assets/

# 部署工具产物（各环境自生成）
*.genie
