<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件配色（浅色）。

  ★ 四色全部走资源而不是写死在 Java 里：values-night 会覆盖同名项，
    这样系统深色模式下小组件才不会是一块刺眼的白板。
-->
<resources>
    <color name="widget_bg">#FAFFFFFF</color>
    <color name="widget_text">#FF1B1B1F</color>
    <color name="widget_sub">#FF6B7280</color>
    <color name="widget_line">#14000000</color>
    <!-- 课程色解析失败时的兜底色条（正常每个课程都有自己的颜色） -->
    <color name="widget_bar">#FF013A89</color>
</resources>
